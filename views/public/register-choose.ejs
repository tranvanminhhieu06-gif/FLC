<%- include('../partials/public-start') %>
<main class="auth-wrap" id="main">
  <div class="auth-card wide">
    <h1 style="text-align:center">Bạn tham gia FLC với vai trò nào?</h1>
    <div class="grid grid-2" style="margin-top: var(--sp-6)">
      <a class="card" href="/register/customer" style="text-decoration:none; color:inherit">
        <div class="icon-box" style="width:44px;height:44px;border-radius:10px;background:var(--c-brand-100);display:grid;place-items:center;color:var(--c-brand-800)"><%- icon('briefcase') %></div>
        <h2 style="margin-top: var(--sp-3)">Khách hàng</h2>
        <p class="muted">Đăng Order, nhận báo giá, theo dõi tiến độ, nghiệm thu và thanh toán.</p>
      </a>
      <a class="card" href="/register/freelancer" style="text-decoration:none; color:inherit">
        <div class="icon-box" style="width:44px;height:44px;border-radius:10px;background:var(--c-accent-100);display:grid;place-items:center;color:var(--c-accent-700)"><%- icon('users') %></div>
        <h2 style="margin-top: var(--sp-3)">Freelancer</h2>
        <p class="muted">Referrer, Sales, Account, PM, Project. Đăng ký một hoặc nhiều vai trò.</p>
      </a>
    </div>
  </div>
</main>
<%- include('../partials/public-end') %>
