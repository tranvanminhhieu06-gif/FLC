<%- include('../partials/app-start') %>
<% const R = ranking; const q = (g) => `/fl/home?group=${g}${service ? '&service=' + encodeURIComponent(service) : ''}`; %>
<div class="page-head">
  <div><h1>Trang chủ FLC</h1><p class="muted">Các dự án khách hàng đã đăng và bảng xếp hạng thành viên theo số dự án hoàn thành.</p></div>
  <% if (user.roles.includes('SALES') || user.roles.includes('ACCOUNT')) { %><a class="btn btn-accent" href="/fl/opportunities"><%- icon('target') %>Cơ hội đang chờ nhận</a><% } %>
</div>

<div class="split">
  <section class="card flush" aria-labelledby="feed-title">
    <div class="card-head"><h2 id="feed-title">Dự án khách hàng đăng</h2>
      <form method="get" action="/fl/home" class="row" style="gap:6px">
        <input type="hidden" name="group" value="<%= group %>">
        <label class="sr-only" for="f_service">Lọc theo dịch vụ</label>
        <select class="select" id="f_service" name="service" style="min-height:36px; width:auto">
          <option value="">Mọi dịch vụ</option>
          <% for (const s of services) { %><option value="<%= s %>" <%- s === service ? 'selected' : '' %>><%= s %></option><% } %>
        </select>
        <button class="btn btn-secondary btn-sm">Lọc</button>
      </form>
    </div>
    <nav class="tabs" aria-label="Nhóm dự án" style="padding: 0 var(--sp-5); margin-bottom: 0">
      <% for (const [k, g] of Object.entries(groups)) { %>
        <a href="<%= q(k) %>" <%- k === group ? 'aria-current="page"' : '' %>><%= g.label %> <span class="badge neutral"><%= counts[k] %></span></a>
      <% } %>
    </nav>
    <% if (!orders.length) { %>
      <div class="empty"><%- icon('briefcase') %><p>Chưa có dự án nào trong nhóm này<%= service ? ' cho dịch vụ đã chọn' : '' %>.</p></div>
    <% } else { %>
      <ul class="feed">
        <% for (const o of orders) { %>
          <li class="feed-item<%= o.mine ? ' mine' : '' %>">
            <div class="feed-main">
              <div class="row small muted" style="gap:6px"><span class="mono"><%= o.code %></span><span class="tag"><%= o.service_type %></span><% if (o.mine) { %><span class="badge brand">Bạn tham gia</span><% } %></div>
              <h3 class="feed-title"><% if (o.canOpen) { %><a href="/orders/<%= o.id %>"><%= o.title %></a><% } else { %><%= o.title %><% } %></h3>
              <dl class="feed-meta">
                <div><dt>Ngân sách</dt><dd><%= o.budget ? fmt.vnd(o.budget) : 'Chưa nêu' %></dd></div>
                <div><dt>Hạn mong muốn</dt><dd><%= fmt.date(o.deadline) %></dd></div>
                <div><dt>Đăng ngày</dt><dd><%= fmt.date(o.submitted_at) %></dd></div>
                <div><dt>Nhân sự</dt><dd><%= o.members ? o.members + ' người' : 'Chưa có' %></dd></div>
              </dl>
            </div>
            <div><%- badge(L.ORDER_STATUS, o.status) %></div>
          </li>
        <% } %>
      </ul>
    <% } %>
    <p class="small muted" style="padding: var(--sp-3) var(--sp-5) var(--sp-4); margin:0">Thông tin khách hàng và chi tiết yêu cầu chỉ hiện khi bạn tham gia Order.</p>
  </section>

  <aside class="card" aria-labelledby="rank-title">
    <h2 id="rank-title" style="margin-top:0">Bảng xếp hạng thành viên</h2>
    <p class="small muted">Số dự án đã hoàn tất mà thành viên được khóa phân công, tính mọi vai trò.</p>
    <% if (!R.top.length) { %>
      <div class="empty" style="padding: var(--sp-6) 0"><%- icon('users') %><p>Chưa có dự án nào hoàn thành.</p></div>
    <% } else { %>
      <ol class="rank-list">
        <% for (const m of R.top) { %>
          <li class="<%= m.id === user.id ? 'me' : '' %>">
            <span class="rank-no<%= m.rank <= 3 ? ' top' + m.rank : '' %>" aria-label="Hạng <%= m.rank %>"><%= m.rank %></span>
            <%- include('../partials/avatar', { person: m, size: 36 }) %>
            <span class="rank-who"><strong><%= m.full_name %></strong><%= m.id === user.id ? ' (bạn)' : '' %>
              <span class="small muted"><span class="mono"><%= m.member_code %></span><% for (const r of (m.roles || '').split(',').filter(Boolean)) { %> · <%= L.ROLES[r].label %><% } %></span></span>
            <span class="rank-score"><strong><%= m.completed %></strong><span class="small muted">dự án</span></span>
          </li>
        <% } %>
      </ol>
    <% } %>
    <% if (R.me && !R.top.some((m) => m.id === user.id)) { %>
      <div class="rank-mine"><%- icon('user') %><div>
        <% if (R.me.completed) { %>Bạn đang ở <strong>hạng <%= R.me.rank %></strong>/<%= R.members %> với <strong><%= R.me.completed %></strong> dự án hoàn thành.
        <% } else { %>Bạn chưa có dự án hoàn thành<%= R.me.active ? `, đang tham gia ${R.me.active} dự án` : '' %>. Hoàn thành dự án đầu tiên để lên bảng xếp hạng.<% } %>
      </div></div>
    <% } %>
  </aside>
</div>
<%- include('../partials/app-end') %>
