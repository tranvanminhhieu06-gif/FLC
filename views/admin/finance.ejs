<%- include('../partials/app-start') %>
<% const C = `<input type="hidden" name="_csrf" value="${csrf()}">`; %>
<div class="page-head"><div><h1>Tài chính &amp; đối soát</h1><p class="muted">Bước 7: xác nhận thực thu, đối soát, duyệt hoa hồng, đưa vào kỳ thanh toán và chi trả. Mọi thao tác đều được ghi lịch sử. <a href="/statuses#commission">Ý nghĩa các trạng thái</a></p></div></div>

<section class="card flush" style="margin-bottom: var(--sp-6)">
  <div class="card-head"><h2>1. Khoản thu chờ xác nhận</h2><span class="badge warn"><%= pendingPayments.length %></span></div>
  <% if (!pendingPayments.length) { %><div class="empty"><p>Không có khoản nào.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Order</th><th>Loại</th><th>Khách báo</th><th>Mã GD</th><th style="min-width:420px">Xác nhận thực thu</th><th></th></tr></thead>
    <tbody><% for (const p of pendingPayments) { %>
      <tr>
        <td><a class="mono" href="/orders/<%= p.order_id %>"><%= p.code %></a><div class="small muted"><%= p.title %> · <%= p.customer_code %></div></td>
        <td><%= L.PAYMENT_KIND[p.kind] %><div class="small muted"><%= p.kind === 'deposit' ? 'Cọc yêu cầu ' + fmt.vnd(p.deposit_amount) : 'HĐ ' + fmt.vnd(p.value) %></div></td>
        <td class="num"><%= fmt.vnd(p.amount) %></td>
        <td class="mono small"><%= p.ref || '—' %></td>
        <td><form method="post" action="/admin/payments/<%= p.id %>/confirm" class="row" style="gap:6px"><%- C %>
          <input class="input" name="amount" value="<%= fmt.num(p.amount) %>" data-money inputmode="numeric" aria-label="Số tiền thực thu" style="width:130px; min-height:36px">
          <input class="input" name="tax" placeholder="Thuế" data-money inputmode="numeric" aria-label="Thuế gián thu" style="width:100px; min-height:36px">
          <input class="input" name="deductions" placeholder="Giảm trừ" data-money inputmode="numeric" aria-label="Giảm trừ doanh thu" style="width:100px; min-height:36px">
          <button class="btn btn-primary btn-sm">Xác nhận</button></form></td>
        <td><details><summary class="small" style="cursor:pointer">Từ chối</summary>
          <form method="post" action="/admin/payments/<%= p.id %>/reject" style="margin-top:4px"><%- C %><input class="input" name="reason" placeholder="Lý do" required aria-label="Lý do từ chối" style="min-height:36px"><button class="btn btn-danger btn-sm" style="margin-top:4px">Từ chối</button></form></details></td>
      </tr>
    <% } %></tbody>
  </table></div><% } %>
</section>

<section class="card flush" style="margin-bottom: var(--sp-6)">
  <div class="card-head"><h2>2. Order có khoản thu chưa đối soát</h2><span class="small muted">Chỉ Order đã khóa tỷ lệ</span></div>
  <% if (!toReconcile.length) { %><div class="empty"><p>Không có.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Order</th><th>Trạng thái</th><th class="num">Số khoản</th><th class="num">Doanh thu thuần</th><th></th></tr></thead>
    <tbody><% for (const o of toReconcile) { %>
      <tr><td><a class="mono" href="/orders/<%= o.id %>"><%= o.code %></a> <%= o.title %></td><td><%- badge(L.ORDER_STATUS, o.status) %></td><td class="num"><%= o.n %></td><td class="num"><%= fmt.vnd(o.net) %></td>
        <td><form method="post" action="/admin/orders/<%= o.id %>/reconcile"><%- C %><button class="btn btn-primary btn-sm">Đối soát</button></form></td></tr>
    <% } %></tbody>
  </table></div><% } %>
</section>

<section class="card flush" style="margin-bottom: var(--sp-6)">
  <div class="card-head"><h2>3. Hoa hồng chờ duyệt</h2><span class="badge warn"><%= pendingCommissions.length %></span></div>
  <p class="small muted" style="padding: 0 var(--sp-5)">Một dòng sang <strong>Đã duyệt</strong> khi freelancer đồng ý <em>và</em> M&amp;T duyệt. Dòng freelancer không đồng ý cần được xử lý: giữ nguyên (kèm giải thích) hoặc hủy.</p>
  <% if (!pendingCommissions.length) { %><div class="empty"><p>Không có.</p></div><% } else { %>
  <form method="post" action="/admin/commissions/approve" id="approve-form"><%- C %></form>
  <div class="table-wrap"><table class="table">
    <thead><tr><th><input type="checkbox" data-check-all="ids" aria-label="Chọn tất cả"></th><th>Order</th><th>Người nhận</th><th>Vai trò</th><th class="num">Cơ sở</th><th class="num">Tỷ lệ</th><th class="num">Phân công</th><th class="num">Số tiền</th><th>Hai bên</th><th></th></tr></thead>
    <tbody><% for (const c of pendingCommissions) { const canApprove = !c.approved_by && !c.objection; %>
      <tr><td><% if (canApprove) { %><input type="checkbox" name="ids" value="<%= c.id %>" form="approve-form" aria-label="Chọn dòng <%= c.id %>"><% } %></td>
        <td><a class="mono" href="/orders/<%= c.order_id %>#commissions"><%= c.code %></a> <span class="small muted">#<%= c.payment_id %></span></td>
        <td><span class="mono small"><%= c.user_code %></span> <%= c.full_name %></td>
        <td><%= L.ROLES[c.role].label %><% if (c.reason) { %><div class="small muted"><%= c.reason %></div><% } %></td>
        <td class="num"><%= fmt.num(c.base_amount) %></td><td class="num"><%= fmt.pct(c.rate_bp) %></td><td class="num"><%= fmt.pct(c.share_bp) %></td>
        <td class="num"><strong><%= fmt.vnd(c.amount) %></strong></td>
        <td class="small">
          <% if (c.objection) { %><span class="badge danger">Freelancer không đồng ý</span><div style="margin-top:4px"><%= c.objection %></div>
          <% } else { %>Freelancer: <%= c.user_confirmed_at ? 'đã đồng ý' : 'chưa xác nhận' %><br>M&amp;T: <%= c.approved_by ? 'đã duyệt' : 'chưa duyệt' %><% } %></td>
        <td>
          <% if (c.objection) { %><details><summary class="small" style="cursor:pointer">Giữ nguyên</summary><form method="post" action="/admin/commissions/<%= c.id %>/dismiss" style="margin-top:4px"><%- C %><input class="input" name="reason" required placeholder="Giải thích cho freelancer" aria-label="Giải thích giữ nguyên" style="min-height:36px"><button class="btn btn-secondary btn-sm" style="margin-top:4px">Giữ nguyên số tiền</button></form></details><% } %>
          <details><summary class="small" style="cursor:pointer">Hủy</summary><form method="post" action="/admin/commissions/<%= c.id %>/void" style="margin-top:4px"><%- C %><input class="input" name="reason" required placeholder="Lý do (VD: không hoàn thành nhiệm vụ)" aria-label="Lý do hủy" style="min-height:36px"><button class="btn btn-danger btn-sm" style="margin-top:4px">Hủy dòng</button></form></details></td></tr>
    <% } %></tbody>
  </table></div>
  <div style="padding: var(--sp-4) var(--sp-5)"><button class="btn btn-primary" form="approve-form">M&amp;T duyệt các dòng đã chọn</button></div>
  <% } %>
</section>

<section class="card flush" style="margin-bottom: var(--sp-6)">
  <div class="card-head"><h2>4. Đã duyệt — đưa vào kỳ thanh toán</h2></div>
  <% if (!approved.length) { %><div class="empty"><p>Không có khoản đã duyệt chờ đưa vào kỳ.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Freelancer</th><th class="num">Số dòng</th><th class="num">Đủ điều kiện</th><th class="num">Đang vướng tranh chấp</th><th>Đưa vào kỳ</th></tr></thead>
    <tbody><% for (const p of approved) { %>
      <tr><td><span class="mono small"><%= p.code %></span> <%= p.full_name %></td>
        <td class="num"><%= p.n %></td><td class="num"><strong><%= fmt.vnd(p.ready) %></strong></td>
        <td class="num"><%= p.blocked ? fmt.vnd(p.blocked) : '—' %></td>
        <td><% if (p.ready > 0) { %><form method="post" action="/admin/payouts" class="row" style="gap:6px"><%- C %><input type="hidden" name="user_id" value="<%= p.id %>">
          <input class="input" type="month" name="period" value="<%= period %>" required aria-label="Kỳ thanh toán" style="width:160px; min-height:36px">
          <button class="btn btn-primary btn-sm">Đưa vào kỳ</button></form><% } else { %><span class="small muted">Chờ xử lý tranh chấp</span><% } %></td></tr>
    <% } %></tbody>
  </table></div><% } %>
</section>

<section class="card flush" style="margin-bottom: var(--sp-6)">
  <div class="card-head"><h2>5. Chờ thanh toán</h2><span class="badge info"><%= scheduled.length %></span></div>
  <% if (!scheduled.length) { %><div class="empty"><p>Không có kỳ nào chờ chi.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Kỳ</th><th>Freelancer</th><th>Tài khoản nhận</th><th class="num">Số dòng</th><th class="num">Tổng</th><th>Ghi nhận chi</th></tr></thead>
    <tbody><% for (const p of scheduled) { %>
      <tr><td class="mono"><%= p.period %></td><td><span class="mono small"><%= p.code %></span> <%= p.full_name %></td><td class="small"><%= p.bank_name %> · <span class="mono"><%= p.bank_account %></span><br><%= p.bank_holder %></td>
        <td class="num"><%= p.n %></td><td class="num"><strong><%= fmt.vnd(p.amount) %></strong></td>
        <td><form method="post" action="/admin/payouts/<%= p.id %>/paid" class="row" style="gap:6px"><%- C %>
          <input class="input" name="ref" required placeholder="Mã giao dịch" aria-label="Mã giao dịch chi trả" style="width:160px; min-height:36px">
          <button class="btn btn-accent btn-sm" data-confirm="Xác nhận đã chuyển <%= fmt.vnd(p.amount) %> cho <%= p.code %>?">Đã chuyển</button></form></td></tr>
    <% } %></tbody>
  </table></div><% } %>
</section>

<section class="card flush">
  <div class="card-head"><h2>Lịch sử chi trả</h2></div>
  <% if (!payouts.length) { %><div class="empty"><p>Chưa có.</p></div><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Ngày chi</th><th>Kỳ</th><th>Freelancer</th><th>Mã GD</th><th class="num">Số tiền</th></tr></thead>
    <tbody><% for (const p of payouts) { %><tr><td><%= fmt.dateTime(p.paid_at) %></td><td class="mono"><%= p.period || '—' %></td><td><span class="mono small"><%= p.code %></span> <%= p.full_name %></td><td class="mono"><%= p.ref %></td><td class="num"><%= fmt.vnd(p.amount) %></td></tr><% } %></tbody>
  </table></div><% } %>
</section>
<%- include('../partials/app-end') %>
